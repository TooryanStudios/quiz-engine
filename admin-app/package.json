{
  "name": "admin-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:tinymce": "node ./scripts/sync-tinymce-assets.mjs",
    "dev": "npm run sync:tinymce && vite",
    "dev:games": "npm run sync:tinymce && vite --open /game-modes",
    "build": "npm run sync:tinymce && tsc -b && vite build",
    "test:workhub-templates": "vitest run tests/workhub-template-contracts.test.ts",
    "stamp-build": "node ./scripts/stamp-build.mjs",
    "build:deploy": "npm run stamp-build && npm run build",
    "build:chatbot": "node ./scripts/build-chatbot.mjs",
    "sync:chatbot-server": "node ./scripts/sync-chatbot-server.mjs",
    "deploy:hosting": "npm run build:deploy && npm run build:chatbot && firebase deploy --project qyan-om --only hosting",
    "deploy:chatbot-fn": "npm run sync:chatbot-server && npm --prefix functions-chatbot install && firebase deploy --project qyan-om --only functions:chatbot",
    "deploy:all": "npm run build:deploy && npm run build:chatbot && npm run sync:chatbot-server && npm --prefix functions-chatbot install && firebase deploy --project qyan-om",
    "deploy:hostgator": "npm run build && node deploy-to-hostgator.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@stripe/stripe-js": "^8.8.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "firebase": "^12.9.0",
    "pagedjs": "^0.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.13.0",
    "tinymce": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ftp-deploy": "^2.4.6",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.8"
  }
}
