{
  "name": "admin-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:tinymce": "node ./scripts/sync-tinymce-assets.mjs",
    "dev": "npm run sync:tinymce && concurrently --restart-tries -1 --restart-after 2000 -n ui,api -c cyan,magenta \"vite\" \"node functions-chatbot/server/index.js\"",
    "dev:ui": "npm run sync:tinymce && vite",
    "dev:videdit": "npm run sync:tinymce && vite --config apps/videdit/vite.config.ts",
    "dev:api": "concurrently --restart-tries -1 --restart-after 2000 -n api -c magenta \"node functions-chatbot/server/index.js\"",
    "dev:games": "npm run sync:tinymce && vite --open /game-modes",
    "build": "npm run sync:tinymce && tsc -b && vite build",
    "build:videdit": "npm run sync:tinymce && vite build --config apps/videdit/vite.config.ts",
    "test:workhub-templates": "vitest run tests/workhub-template-contracts.test.ts",
    "test:workhub-proscons": "vitest run tests/workhub-proscons-engine.test.ts",
    "stamp-build": "node ./scripts/stamp-build.mjs",
    "build:deploy": "npm run stamp-build && npm run build",
    "build:chatbot": "node ./scripts/build-chatbot.mjs",
    "sync:chatbot-server": "node ./scripts/sync-chatbot-server.mjs",
    "smoke:platform:e2e": "node ./functions-chatbot/tools/platform-e2e-smoke.mjs",
    "test:platform:abuse-controls": "node ./functions-chatbot/tools/platform-abuse-control-test.mjs",
    "secrets:platform:webhook:rotate": "node ./scripts/rotate-platform-webhook-secret.mjs",
    "alerts:platform:setup": "node ./scripts/setup-platform-alerting.mjs",
    "dashboards:platform:setup": "node ./scripts/setup-platform-dashboards.mjs",
    "observability:platform:refresh": "node ./scripts/refresh-platform-observability.mjs",
    "deploy:hosting": "npm run build:deploy && npm run build:chatbot && firebase deploy --project qyan-om --only hosting",
    "deploy:chatbot-fn": "npm run sync:chatbot-server && npm --prefix functions-chatbot install && firebase deploy --project qyan-om --only functions:chatbot && npm run smoke:platform:e2e",
    "deploy:all": "npm run build:deploy && npm run build:chatbot && npm run sync:chatbot-server && npm --prefix functions-chatbot install && firebase deploy --project qyan-om && npm run smoke:platform:e2e",
    "deploy:hostgator": "npm run build && node deploy-to-hostgator.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cesdk/cesdk-js": "^1.74.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/bundler": "4.0.458",
    "@remotion/google-fonts": "^4.0.458",
    "@remotion/media-parser": "^4.0.458",
    "@remotion/player": "^4.0.458",
    "@remotion/renderer": "^4.0.458",
    "@stripe/stripe-js": "^8.8.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dockview-react": "^6.0.3",
    "firebase": "^12.9.0",
    "html-to-image": "^1.11.13",
    "img-comparison-slider": "^8.0.7",
    "lucide-react": "^1.14.0",
    "mediabunny": "^1.44.1",
    "pagedjs": "^0.4.3",
    "posthog-js": "^1.372.10",
    "react": "^19.2.0",
    "react-best-gradient-color-picker": "^3.0.14",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-hotkeys-hook": "^5.3.2",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.13.0",
    "remotion": "^4.0.458",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tinymce": "^8.4.0",
    "uuid": "^14.0.0",
    "video.js": "^8.23.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ftp-deploy": "^2.4.6",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.8"
  }
}
