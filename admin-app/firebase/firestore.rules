rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Primary: custom `admin` claim set by the grantAdminClaim Cloud Function.
    // The email fallback is temporary for existing sessions that predate the
    // claim. Once the admin calls grantAdminClaim (done automatically by
    // App.tsx on sign-in), the email line below can be removed.
    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true
      );
    }

    function workhubMemberDoc() {
      return get(/databases/$(database)/documents/workhub_members/$(request.auth.uid));
    }

    function workhubMemberExists() {
      return exists(/databases/$(database)/documents/workhub_members/$(request.auth.uid));
    }

    function isApprovedWorkhubMember() {
      return isSignedIn()
        && workhubMemberExists()
        && workhubMemberDoc().data.status == 'approved';
    }

    function canAccessWorkhub() {
      return isMasterAdmin() || isApprovedWorkhubMember();
    }

    function isPrivilegedWorkhubMember() {
      return isMasterAdmin() || (
        isApprovedWorkhubMember()
        && (workhubMemberDoc().data.role == 'admin' || workhubMemberDoc().data.role == 'manager')
      );
    }

    function isVisibleWorkhubEntity(data) {
      return data.visibility == 'workspace'
        || data.createdBy == request.auth.uid
        || request.auth.uid in data.memberUids;
    }

    function workhubTaskDoc(taskId) {
      return get(/databases/$(database)/documents/workhub_tasks/$(taskId));
    }

    function workhubTaskExists(taskId) {
      return exists(/databases/$(database)/documents/workhub_tasks/$(taskId));
    }

    function canReadWorkhubTask(taskId) {
      return isPrivilegedWorkhubMember() || (
        canAccessWorkhub()
        && workhubTaskExists(taskId)
        && isVisibleWorkhubEntity(workhubTaskDoc(taskId).data)
      );
    }

    function workhubProjectDoc(projectId) {
      return get(/databases/$(database)/documents/workhub_projects/$(projectId));
    }

    function workhubProjectExists(projectId) {
      return exists(/databases/$(database)/documents/workhub_projects/$(projectId));
    }

    function canReadWorkhubProject(projectId) {
      return isPrivilegedWorkhubMember() || (
        canAccessWorkhub()
        && workhubProjectExists(projectId)
        && isVisibleWorkhubEntity(workhubProjectDoc(projectId).data)
      );
    }

    function hasSameMembers(left, right) {
      return left is list
        && right is list
        && left.hasAll(right)
        && right.hasAll(left);
    }

    function respectsParentProjectScope(data) {
      return !(data.parentProjectId is string)
        || data.parentProjectId == ''
        || (
          workhubProjectExists(data.parentProjectId)
          && workhubProjectDoc(data.parentProjectId).data.workspaceId == data.workspaceId
          && (
            workhubProjectDoc(data.parentProjectId).data.visibility != 'restricted'
            || (
              data.visibility == 'restricted'
              && hasSameMembers(data.memberUids, workhubProjectDoc(data.parentProjectId).data.memberUids)
            )
          )
        );
    }

    function canWriteProjectScopedEntity(data) {
      return data.projectId is string
        && data.projectId != ''
        && (
          data.projectId == '__adhoc__'
          || (
            workhubProjectExists(data.projectId)
            && workhubProjectDoc(data.projectId).data.workspaceId == data.workspaceId
            && (
              workhubProjectDoc(data.projectId).data.visibility != 'restricted'
              || (
                data.visibility == 'restricted'
                && hasSameMembers(data.memberUids, workhubProjectDoc(data.projectId).data.memberUids)
              )
            )
          )
        );
    }

    function canWriteDocumentScope(data) {
      return !(data.projectId is string)
        || data.projectId == ''
        || canWriteProjectScopedEntity(data);
    }

    function workhubDocumentDoc(documentId) {
      return get(/databases/$(database)/documents/workhub_documents/$(documentId));
    }

    function workhubDocumentExists(documentId) {
      return exists(/databases/$(database)/documents/workhub_documents/$(documentId));
    }

    function canReadWorkhubDocument(documentId) {
      return isPrivilegedWorkhubMember() || (
        canAccessWorkhub()
        && workhubDocumentExists(documentId)
        && isVisibleWorkhubEntity(workhubDocumentDoc(documentId).data)
      );
    }

    function canReadWorkhubComment(data) {
      return canReadWorkhubTask(data.taskId)
        || (data.entityType == 'task' && canReadWorkhubTask(data.entityId))
        || (data.entityType == 'project' && canReadWorkhubProject(data.entityId))
        || (data.entityType == 'document' && canReadWorkhubDocument(data.entityId));
    }

    function isValidVoiceTestRoom(roomId) {
      return roomId.matches('^test-[a-z0-9-]{3,36}$');
    }

    // Quizzes: anyone can read (needed by the play server via REST API);
    // only the owner can create/modify/delete.
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // Packs are public for storefront display; only owners/admins can mutate
    match /packs/{packId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // User profiles: users can read/write their own; master admin can read/write all
    match /users/{userId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow create, update: if isOwner(userId) || isMasterAdmin();
      allow delete: if isMasterAdmin();

      match /reference_library/{itemId} {
        allow read, create, update, delete: if isOwner(userId) || isMasterAdmin();
      }

      match /toorgen_extend_generations/{taskId} {
        allow read, create, update: if isOwner(userId) || isMasterAdmin();
        allow delete: if isOwner(userId) || isMasterAdmin();
      }

      match /toorgen_prompt_lab_generations/{entryId} {
        allow read, create, update: if isOwner(userId) || isMasterAdmin();
        allow delete: if isOwner(userId) || isMasterAdmin();
      }
    }

    match /entitlements/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Experimental voice signaling (testing only)
    // Room id must start with `test-` to keep scope intentionally limited.
    match /voiceRooms/{roomId} {
      allow read, create, update: if isSignedIn() && isValidVoiceTestRoom(roomId);
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if isSignedIn() && isValidVoiceTestRoom(roomId);
        allow create, update, delete: if isSignedIn() && isValidVoiceTestRoom(roomId);
      }

      match /signals/{signalId} {
        allow read: if isSignedIn() && isValidVoiceTestRoom(roomId);
        allow create: if isSignedIn() && isValidVoiceTestRoom(roomId);
        allow update, delete: if false;
      }
    }

    // Platform-wide engagement stats (write: any signed-in user; read: any signed-in user)
    match /platform_stats/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Platform settings (readable by signed-in users, writable by master admin only)
    match /platform_settings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isMasterAdmin();
      allow delete: if false;
    }

    // Theme editor settings are publicly readable so the game server can resolve
    // dynamic themes via the Firestore REST API without requiring auth credentials.
    match /platform_settings/theme_editor {
      allow read: if true;
    }

    // Fish Fence levels are published by the builder and consumed by /play at runtime.
    // Public write is intentionally scoped to this single document for dynamic level syncing.
    match /platform_settings/fish_fence_count_levels {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /workhub_members/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || canAccessWorkhub()
      );
      allow create, update, delete: if false;
    }

    match /workhub_workspaces/{workspaceId} {
      allow read: if canAccessWorkhub();
      allow create, update, delete: if isPrivilegedWorkhubMember();
    }

    match /workhub_projects/{projectId} {
      allow read: if isPrivilegedWorkhubMember() || (canAccessWorkhub() && isVisibleWorkhubEntity(resource.data));
      allow create: if canAccessWorkhub() && respectsParentProjectScope(request.resource.data);
      allow update: if canAccessWorkhub() && respectsParentProjectScope(request.resource.data);
      allow delete: if canAccessWorkhub();
    }

    match /workhub_documents/{documentId} {
      // Public read access when a valid share token is presented
      allow read: if (resource.data.shareEnabled == true && resource.data.shareToken != null && resource.data.shareToken != '')
        || isPrivilegedWorkhubMember()
        || (canAccessWorkhub() && isVisibleWorkhubEntity(resource.data));
      // Public write access when sharing is enabled (allows body/title edits via shared link)
      allow update: if (
        (resource.data.shareEnabled == true && resource.data.shareToken != null
          && request.resource.data.shareToken == resource.data.shareToken
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.isLocked != true)
        || canAccessWorkhub()
      )
      && canWriteDocumentScope(request.resource.data);
      allow create: if canAccessWorkhub() && canWriteDocumentScope(request.resource.data);
      allow delete: if canAccessWorkhub() && canWriteDocumentScope(resource.data);
    }

    match /workhub_document_drafts/{draftId} {
      allow read: if canAccessWorkhub()
        && resource.data.userUid == request.auth.uid
        && resource.data.documentId is string
        && canReadWorkhubDocument(resource.data.documentId);
      allow create: if canAccessWorkhub()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.documentId is string
        && canReadWorkhubDocument(request.resource.data.documentId);
      allow update: if canAccessWorkhub()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.documentId == resource.data.documentId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && canReadWorkhubDocument(resource.data.documentId);
      allow delete: if canAccessWorkhub() && resource.data.userUid == request.auth.uid;
    }

    match /workhub_tasks/{taskId} {
      allow read: if isPrivilegedWorkhubMember() || (canAccessWorkhub() && isVisibleWorkhubEntity(resource.data));
      allow create: if canAccessWorkhub() && canWriteProjectScopedEntity(request.resource.data);
      allow update: if canAccessWorkhub() && canWriteProjectScopedEntity(request.resource.data);
      allow delete: if canAccessWorkhub() && canWriteProjectScopedEntity(resource.data);
    }

    match /workhub_task_comments/{commentId} {
      allow read: if canReadWorkhubComment(resource.data);
      allow create, update, delete: if canAccessWorkhub();
    }

    match /workhub_activity/{activityId} {
      allow read: if isPrivilegedWorkhubMember() || (canAccessWorkhub() && isVisibleWorkhubEntity(resource.data));
      allow create, update, delete: if canAccessWorkhub();
    }

    match /workhub_notifications/{notificationId} {
      allow read: if isPrivilegedWorkhubMember() || (canAccessWorkhub() && resource.data.recipientUid == request.auth.uid);
      allow create: if canAccessWorkhub();
      allow update: if canAccessWorkhub()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.actorUid == resource.data.actorUid
        && request.resource.data.entityType == resource.data.entityType
        && request.resource.data.entityId == resource.data.entityId
        && request.resource.data.action == resource.data.action
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /workhub_project_notification_prefs/{prefId} {
      allow read: if canAccessWorkhub();
      allow create: if canAccessWorkhub()
        && request.resource.data.userUid == request.auth.uid;
      allow update: if canAccessWorkhub()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false;
    }

    match /workhub_clients/{clientId} {
      allow read: if canAccessWorkhub();
      allow create, update, delete: if canAccessWorkhub();
    }

    match /workhub_company_services/{serviceId} {
      allow read: if canAccessWorkhub();
      allow create, update, delete: if isPrivilegedWorkhubMember();
    }

    match /workhub_finances/{projectId} {
      allow read: if isPrivilegedWorkhubMember();
      allow create, update, delete: if isPrivilegedWorkhubMember();

      match /expenses/{expenseId} {
        allow read: if isPrivilegedWorkhubMember();
        allow create, update, delete: if isPrivilegedWorkhubMember();
      }
    }

    match /workhub_mood_boards/{boardId} {
      allow read: if canAccessWorkhub() && (
        isPrivilegedWorkhubMember()
        || resource.data.visibility != 'restricted'
        || resource.data.createdBy == request.auth.uid
        || request.auth.uid in resource.data.memberUids
      );
      allow create, update, delete: if canAccessWorkhub();
    }

    match /workhub_milestones/{milestoneId} {
      allow read: if isPrivilegedWorkhubMember() || (canAccessWorkhub() && canReadWorkhubProject(resource.data.projectId));
      allow create, update, delete: if isPrivilegedWorkhubMember();
    }

    match /toorgen_sequencer_timelines/{timelineId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ─── Studio: Organizations ───────────────────────────────────────────────
    //
    // studio_orgs/{orgId}
    //   members/{userId}
    //
    // Access model:
    //   • Any signed-in user can create an org (they become owner).
    //   • An org document is readable by its owner and any member recorded in
    //     the members subcollection.  The helper isOrgMember() performs a
    //     cross-document read — acceptable because it is only called on org
    //     docs (not on high-frequency subcollection reads).
    //   • Org metadata updates are restricted to owner and admin members.
    //   • Deletion is restricted to the owner only.
    //
    // NOTE: The `memberCount` field is denormalized for display only and is
    // not used in any security decision.

    function isStudioEligibleUser() {
      return isSignedIn()
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        );
    }

    function isOrgMember(orgId) {
      return isStudioEligibleUser()
        && exists(/databases/$(database)/documents/studio_orgs/$(orgId)/members/$(request.auth.uid));
    }

    function orgMemberDoc(orgId) {
      return get(/databases/$(database)/documents/studio_orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgAdminOrOwner(orgId) {
      return isStudioEligibleUser()
        && isOrgMember(orgId)
        && (orgMemberDoc(orgId).data.role == 'owner' || orgMemberDoc(orgId).data.role == 'admin');
    }

    match /studio_orgs/{orgId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isOrgMember(orgId));
      allow create: if isStudioEligibleUser()
        // Caller must set themselves as owner
        && request.resource.data.ownerId == request.auth.uid
        // Required fields
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.slug is string
        && request.resource.data.plan is string;
      allow update: if isOrgAdminOrOwner(orgId)
        // ownerId is immutable after creation
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        // Any org member can read the full member list (needed for invite flows)
        allow read: if isSignedIn()
          && (request.auth.uid == userId || isOrgMember(orgId));
        // Only org admins/owners can add or update members.
        // Bootstrap exception: allow creating the caller's owner member doc in
        // the same transaction that creates the org.
        allow create: if (
            isOrgAdminOrOwner(orgId)
            || (
              isStudioEligibleUser()
              && request.auth.uid == userId
              && request.resource.data.userId == userId
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/studio_orgs/$(orgId)).data.ownerId == request.auth.uid
            )
          )
          && request.resource.data.userId == userId;
        allow update: if isOrgAdminOrOwner(orgId)
          && request.resource.data.userId == userId;
        // Admins/owners can remove others; members can remove themselves
        allow delete: if isSignedIn()
          && (request.auth.uid == userId || isOrgAdminOrOwner(orgId));
      }
    }

    // ─── Studio: Projects ────────────────────────────────────────────────────
    //
    // studio_projects/{projectId}
    //   members/{userId}
    //
    // Access model:
    //   • 'private'  — only users listed in memberUids can read.
    //   • 'org'      — any member of the project's parent org can read.
    //   • 'shared'   — any user in memberUids can read, regardless of org.
    //
    // The `memberUids` array is a denormalized copy of the members subcollection
    // UIDs, maintained in sync by the service layer.  Security rules use this
    // array for O(1) access checks without extra reads.

    function isProjectMember(projectId) {
      return isStudioEligibleUser()
        && exists(/databases/$(database)/documents/studio_projects/$(projectId)/members/$(request.auth.uid));
    }

    function projectMemberDoc(projectId) {
      return get(/databases/$(database)/documents/studio_projects/$(projectId)/members/$(request.auth.uid));
    }

    function isProjectOwnerOrEditor(projectId) {
      return isStudioEligibleUser()
        && isProjectMember(projectId)
        && (projectMemberDoc(projectId).data.role == 'owner'
            || projectMemberDoc(projectId).data.role == 'editor');
    }

    function canReadStudioProject(data) {
      return isStudioEligibleUser() && (
        // Owner can always read
        data.ownerId == request.auth.uid
        // Any explicit member can read — this standalone condition is required so
        // that Firestore's query engine can statically prove the query
        //   where('memberUids', 'array-contains', userId)
        // is safe to run (Firestore rejects queries where the WHERE clause alone
        // cannot guarantee all results satisfy the read rule).
        || request.auth.uid in data.memberUids
        // Org-wide: any org member can read (even without explicit membership)
        || (data.visibility == 'org' && isOrgMember(data.orgId))
      );
    }

    match /studio_projects/{projectId} {
      allow read: if canReadStudioProject(resource.data);
      allow create: if isStudioEligibleUser()
        // Caller must belong to the target org, or create in personal namespace.
        && (isOrgMember(request.resource.data.orgId) || request.resource.data.orgId == request.auth.uid)
        // Caller must set themselves as owner
        && request.resource.data.ownerId == request.auth.uid
        // Caller must be in memberUids on creation
        && request.auth.uid in request.resource.data.memberUids
        // Required fields
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.visibility is string
        // orgId is immutable after creation (enforced here on create; checked on update)
        && request.resource.data.orgId is string;
      allow update: if isProjectOwnerOrEditor(projectId)
        // orgId is immutable
        && request.resource.data.orgId == resource.data.orgId
        // ownerId is immutable (ownership transfer not supported client-side)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isOrgAdminOrOwner(resource.data.orgId));

      match /members/{userId} {
        // Project members can read the member list; org admins can too
        allow read: if isSignedIn()
          && (request.auth.uid == userId
              || isProjectMember(projectId)
              || isOrgAdminOrOwner(resource.data.get('orgId', '')));
        // Project owners/editors can manage members.
        // Bootstrap exception: allow creating the caller's owner member doc in
        // the same transaction that creates the project.
        allow create: if (
            isProjectOwnerOrEditor(projectId)
            || (
              isStudioEligibleUser()
              && request.auth.uid == userId
              && request.resource.data.userId == userId
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/studio_projects/$(projectId)).data.ownerId == request.auth.uid
            )
          )
          && request.resource.data.userId == userId;
        allow update: if isProjectOwnerOrEditor(projectId)
          && request.resource.data.userId == userId;
        allow delete: if isSignedIn()
          && (request.auth.uid == userId || isProjectOwnerOrEditor(projectId));
      }

      match /folders/{folderId} {
        allow read: if canReadStudioProject(
          get(/databases/$(database)/documents/studio_projects/$(projectId)).data)
          && (
            isProjectOwnerOrEditor(projectId)
            || request.auth.uid in resource.data.viewerUids
          );
        allow create: if isProjectOwnerOrEditor(projectId)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 120
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isProjectOwnerOrEditor(projectId)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 120;
        allow delete: if isProjectOwnerOrEditor(projectId);
      }

      match /reference_library/{itemId} {
        allow read: if canReadStudioProject(
          get(/databases/$(database)/documents/studio_projects/$(projectId)).data)
          || (isSignedIn() && resource.data.createdBy == request.auth.uid);
        allow create: if isProjectOwnerOrEditor(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.kind is string
          && request.resource.data.url is string
          && request.resource.data.url.size() >= 1
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isProjectOwnerOrEditor(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.url == resource.data.url
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isProjectOwnerOrEditor(projectId);
      }

      match /flow_canvas/{scopeId} {
        allow read: if canReadStudioProject(
          get(/databases/$(database)/documents/studio_projects/$(projectId)).data);
        allow create, update, delete: if isProjectOwnerOrEditor(projectId);
      }

      match /video_docs/{docId} {
        allow read: if canReadStudioProject(
          get(/databases/$(database)/documents/studio_projects/$(projectId)).data);
        allow create, update, delete: if isProjectOwnerOrEditor(projectId);
      }
    }

    // Explicit creator read path for collectionGroup(reference_library) queries.
    // This keeps user-owned asset-library reads resilient when query planning
    // cannot prove the project-visibility branch above.
    match /studio_projects/{projectId}/reference_library/{itemId} {
      allow read: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Catch-all creator read path for any collectionGroup(reference_library)
    // query. If legacy or alternative paths exist with the same collection
    // name, this prevents false permission-denied failures for
    // where('createdBy', '==', uid) reads.
    match /{path=**}/reference_library/{itemId} {
      allow read: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ─── Studio: Notifications ───────────────────────────────────────────────
    //
    // studio_notifications/{notificationId}
    //
    // Lightweight notification documents keyed by recipientUid.
    // Any authenticated user can receive one (no Studio eligibility required),
    // so invites reach brand-new users before they join an org.

    match /studio_notifications/{notificationId} {
      // Recipient can always read their own notifications.
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      // Any signed-in user can create a notification addressed to someone else
      // (e.g. sender writes a notification for the invitee).
      allow create: if isSignedIn()
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid.size() > 0
        && request.resource.data.createdBy == request.auth.uid;
      // Only the recipient can mark it read.
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // ─── Studio: Invites ─────────────────────────────────────────────────────
    //
    // studio_invites/{inviteId}
    //
    // Invites are created by org/project admins. The invitee (matched by email)
    // can read and accept/decline their own invites. Anyone with the raw
    // document ID can read (needed for token-based acceptance links).

    match /studio_invites/{inviteId} {
      // Invitee can always read their own invite (regardless of Studio eligibility,
      // since they may be a new user who hasn't been granted Studio access yet).
      // Inviter and org/project admins also read, subject to isStudioEligibleUser.
      allow read: if isSignedIn()
        && (
          resource.data.inviteeUid == request.auth.uid
          || resource.data.inviteeEmail == request.auth.token.email
          || (isStudioEligibleUser()
              && (resource.data.invitedBy == request.auth.uid
                  || isOrgAdminOrOwner(resource.data.orgId)))
        );
      allow create: if isStudioEligibleUser()
        && request.resource.data.invitedBy == request.auth.uid
        && (isOrgAdminOrOwner(request.resource.data.orgId)
            || isProjectOwnerOrEditor(request.resource.data.targetId))
        && request.resource.data.status == 'pending'
        && request.resource.data.token is string
        && request.resource.data.token.size() == 48
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail.size() >= 3;
      // Only status field can be updated (accept / decline / expire).
      // Invitee can update their own invite even if not yet Studio-eligible.
      allow update: if isSignedIn()
        && request.resource.data.invitedBy == resource.data.invitedBy
        && request.resource.data.targetKind == resource.data.targetKind
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.inviteeUid == resource.data.inviteeUid
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && request.resource.data.token == resource.data.token
        && request.resource.data.status in ['accepted', 'declined', 'expired']
        && (resource.data.inviteeEmail == request.auth.token.email
            || resource.data.inviteeUid == request.auth.uid
            || (isStudioEligibleUser()
                && (resource.data.invitedBy == request.auth.uid
                    || isOrgAdminOrOwner(resource.data.orgId))));
      allow delete: if false;
    }

    // Workflow Builder Media Library — shared upload library for the canvas
    match /workflow_builder_media/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['url', 'name', 'type', 'storagePath', 'mimeType', 'size'])
        && request.resource.data.type in ['image', 'video'];
      allow update: if isSignedIn()
        && request.resource.data.type == resource.data.type;
      allow delete: if isSignedIn();
    }
  }
}
