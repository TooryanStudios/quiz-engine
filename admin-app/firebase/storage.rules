rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function quizDoc(quizId) {
      return firestore.get(/databases/(default)/documents/quizzes/$(quizId));
    }

    function quizExists(quizId) {
      return exists(/databases/(default)/documents/quizzes/$(quizId));
    }

    function isQuizOwner(quizId) {
      return request.auth != null
        && quizExists(quizId)
        && quizDoc(quizId).data.ownerId == request.auth.uid;
    }

    function isQuizPublic(quizId) {
      return quizExists(quizId)
        && quizDoc(quizId).data.visibility == 'public';
    }

    // Quiz-scoped assets (preferred): public iff quiz is public.
    match /quiz-assets/{quizId}/{allPaths=**} {
      allow read: if isQuizPublic(quizId) || isQuizOwner(quizId);
      allow write: if isQuizOwner(quizId)
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // quiz-media uploads: any authenticated user can write (testing mode)
    match /quiz-media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB limit
    }
    // quiz cover image uploads
    match /quiz-covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB limit
    }

    // match-plus pair and puzzle image uploads
    match /quiz-match-plus/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB limit
    }

    // mini-game assets (e.g. match-plus-arena default puzzle image)
    match /mini-games/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB limit
    }

    // theme background images uploaded from the admin theme editor
    match /theme-bg/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB limit
    }

    function canWriteWorkhubAttachment() {
      // Only require authentication — size limit is enforced in the upload UI.
      // Accessing request.resource.size can throw on some SDK upload paths and is not
      // needed here since moodboard uploads originate from trusted app code.
      return request.auth != null;
    }

    // WorkHub task/checklist attachments
    match /workhub-attachments/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteWorkhubAttachment();
    }

    // WorkHub moodboard images
    match /workhub-moodboards/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteWorkhubAttachment();
    }

    // WorkHub client assets (logos)
    match /workhub-clients/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteWorkhubAttachment();
    }

    // WorkHub workspace asset library (logos, shared images)
    match /workhub-assets/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteWorkhubAttachment();
    }

    // WorkHub chat image attachments
    match /workhub_chat_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteWorkhubAttachment();
    }

    // Legacy WorkHub attachment path kept for backwards compatibility
    match /workhub/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteWorkhubAttachment();
    }

    // Video extension media uploaded from ToorGen (public read for Seedance API)
    match /toorgen-extend/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }

    // ToorGen Prompt Lab uploads (input media and generated outputs).
    // Public read is required so upstream video providers can fetch references.
    match /toorgen-lab/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 80 * 1024 * 1024;
    }

    // Workflow Builder generated outputs (video previews and persisted runs).
    // Keep public read so generated videos remain playable in the builder UI.
    match /workflow-builder/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 80 * 1024 * 1024;
    }

    // Seedance reference images uploaded from ToorGen (public read so Seedance API can fetch them)
    match /seedance-references/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType != null
                   && request.resource.contentType.matches('image/.*');
    }

    // Lab New Layout – composer reference assets (images and videos).
    // Public read so the generation API can fetch them as references.
    match /lab-references/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 80 * 1024 * 1024;
    }
  }
}
