# Required
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Allow requests from the Firebase Hosting domain
FRONTEND_ORIGIN=https://qyan.app

# Optional — keep defaults or override
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_INSTRUCTIONS=You are Ahmed, a concise and friendly assistant.
OPENAI_REALTIME_INSTRUCTIONS=You are Ahmed, a concise and friendly voice assistant.

# Integration endpoints (leave blank to use mock/local adapters)
INTEGRATION_TIMEOUT_MS=15000
INTEGRATION_API_KEY=
INTEGRATION_BEARER_TOKEN=
SERVICES_LOOKUP_URL=
REPORTS_LOOKUP_URL=
INSIGHTS_LOOKUP_URL=
IMAGE_LIBRARY_URL=
SUPPORT_TICKETS_URL=

# Seedance 2.0 (server-side only)
SEEDANCE_API_KEY=
SEEDANCE_API_BASE_URL=https://seedanceapi.org
SEEDANCE_MODEL=seedance-2.0
