# Required
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Allow requests from the Firebase Hosting domain
FRONTEND_ORIGIN=https://qyan.app

# Optional — keep defaults or override
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_INSTRUCTIONS=You are Ahmed, a concise and friendly assistant.
OPENAI_REALTIME_INSTRUCTIONS=You are Ahmed, a concise and friendly voice assistant.

# Integration endpoints (leave blank to use mock/local adapters)
INTEGRATION_TIMEOUT_MS=15000
INTEGRATION_API_KEY=
INTEGRATION_BEARER_TOKEN=
SERVICES_LOOKUP_URL=
REPORTS_LOOKUP_URL=
INSIGHTS_LOOKUP_URL=
IMAGE_LIBRARY_URL=
SUPPORT_TICKETS_URL=

# Seedance 2.0 (server-side only)
SEEDANCE_API_KEY=
SEEDANCE_API_BASE_URL=https://seedanceapi.org
SEEDANCE_MODEL=seedance-2.0-fast
 
# xAI Grok image generation (used for grok-imagine-image-* models)
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_IMAGE_GENERATE_PATH=/images/generations
XAI_IMAGE_EDIT_PATH=/images/edits
XAI_GENERATE_TIMEOUT_MS=45000
# xAI Grok video generation (used for grok-imagine-video models)
XAI_VIDEO_GENERATE_PATH=/videos/generations
XAI_VIDEO_STATUS_PATH=/videos/{request_id}
XAI_VIDEO_STATUS_REQUEST_ID_PARAM=request_id
# Optional provider/gateway overrides (Atlas Cloud or any compatible endpoint)
# If your provider has different routes, auth format, or model names, set these:
SEEDANCE_GENERATE_PATH_V1=/v1/generate
SEEDANCE_GENERATE_PATH_V2=/v2/generate
SEEDANCE_STATUS_PATH_V2=/v2/status
SEEDANCE_STATUS_TASK_ID_PARAM=task_id
SEEDANCE_AUTH_HEADER=Authorization
SEEDANCE_AUTH_PREFIX=Bearer
# Force all models to use the v2 generate route (skip legacy v1 behavior for 1.5)
SEEDANCE_FORCE_V2=false
# JSON map from app model ids -> provider model ids
# Example:
# SEEDANCE_MODEL_ALIASES_JSON={"seedance-2.0-fast":"bytedance/seedance-2.0-fast/text-to-video","seedance-2.0":"bytedance/seedance-2.0-fast/text-to-video","seedance-1.5":"bytedance/seedance-v1-pro-t2v-720p"}
SEEDANCE_MODEL_ALIASES_JSON=

# Atlas Cloud preset example:
# SEEDANCE_API_BASE_URL=https://api.atlascloud.ai
# SEEDANCE_GENERATE_PATH_V2=/api/v1/model/generateVideo
# SEEDANCE_STATUS_PATH_V2=/api/v1/model/prediction/{task_id}
# SEEDANCE_AUTH_HEADER=Authorization
# SEEDANCE_AUTH_PREFIX=Bearer
# SEEDANCE_FORCE_V2=true

# Optional split-provider routing by model:
# - seedance-2.0-fast -> FAST profile (Atlas Cloud recommended)
# - seedance-2.0      -> PRO profile (seedanceapi.org recommended)
# - other models      -> default SEEDANCE_* profile above

# FAST profile (Atlas Cloud)
SEEDANCE_FAST_API_KEY=
SEEDANCE_FAST_API_BASE_URL=https://api.atlascloud.ai
SEEDANCE_FAST_GENERATE_PATH_V2=/api/v1/model/generateVideo
SEEDANCE_FAST_STATUS_PATH_V2=/api/v1/model/prediction/{task_id}
SEEDANCE_FAST_STATUS_TASK_ID_PARAM=task_id
SEEDANCE_FAST_AUTH_HEADER=Authorization
SEEDANCE_FAST_AUTH_PREFIX=Bearer
SEEDANCE_FAST_FORCE_V2=true
SEEDANCE_FAST_MODEL_ALIASES_JSON=

# PRO profile (seedanceapi.org)
SEEDANCE_PRO_API_KEY=
SEEDANCE_PRO_API_BASE_URL=https://seedanceapi.org
SEEDANCE_PRO_GENERATE_PATH_V2=/v2/generate
SEEDANCE_PRO_STATUS_PATH_V2=/v2/status
SEEDANCE_PRO_STATUS_TASK_ID_PARAM=task_id
SEEDANCE_PRO_AUTH_HEADER=Authorization
SEEDANCE_PRO_AUTH_PREFIX=Bearer
SEEDANCE_PRO_FORCE_V2=false
SEEDANCE_PRO_MODEL_ALIASES_JSON=

# Platform infrastructure (phase 1 foundation)
# Storage bucket used for signed upload sessions in /api/platform/uploads/*
PLATFORM_UPLOADS_BUCKET=

# Signed upload URL TTL (seconds)
PLATFORM_UPLOAD_SIGNED_URL_TTL_SEC=900

# Platform store backend: firestore (default) or memory
PLATFORM_STORE_BACKEND=firestore

# Firestore collection names for persistent platform state
PLATFORM_WORKFLOW_JOBS_COLLECTION=platform_workflow_jobs
PLATFORM_UPLOAD_SESSIONS_COLLECTION=platform_upload_sessions

# Health endpoint sample size for store aggregation
PLATFORM_STORE_HEALTH_SAMPLE_LIMIT=500

# Max page size guard for high-volume list endpoints
PLATFORM_LIST_MAX_LIMIT=50

# Secret for /api/platform/uploads/validation-webhook
# Production: store in Secret Manager as PLATFORM_VALIDATION_WEBHOOK_SECRET
# and bind it to the chatbot function via firebase-functions defineSecret.
# Local fallback only:
PLATFORM_VALIDATION_WEBHOOK_SECRET=

# Memory fallback workflow job store controls
PLATFORM_WORKFLOW_JOB_RETENTION_MS=86400000
PLATFORM_WORKFLOW_MAX_JOBS=5000

# Memory fallback upload session store controls
PLATFORM_UPLOAD_SESSION_RETENTION_MS=86400000
PLATFORM_UPLOAD_SESSION_MAX_COUNT=10000

# Scheduled retention + archival policy for Firestore platform collections
PLATFORM_RETENTION_ENABLED=true
PLATFORM_RETENTION_SCHEDULE=every 24 hours
PLATFORM_RETENTION_TIMEZONE=UTC
PLATFORM_RETENTION_DAYS=30
PLATFORM_RETENTION_BATCH_SIZE=200
PLATFORM_RETENTION_MAX_DELETES_PER_RUN=2000
PLATFORM_WORKFLOW_JOBS_ARCHIVE_COLLECTION=platform_workflow_jobs_archive
PLATFORM_UPLOAD_SESSIONS_ARCHIVE_COLLECTION=platform_upload_sessions_archive

# Optional staging URL used by authenticated Seedance smoke tests.
# Example: https://staging---chatbot-blux3lwhuq-uc.a.run.app
PLATFORM_STAGING_BASE_URL=

# Optional comma-separated override for seedance smoke target URLs.
# If set, this overrides PLATFORM_BASE_URL/CHATBOT_FUNCTION_URL + PLATFORM_STAGING_BASE_URL.
SEEDANCE_SMOKE_URLS=
SEEDANCE_SMOKE_MODEL=seedance-2.0-fast
SEEDANCE_SMOKE_REQUEST_TIMEOUT_MS=45000
