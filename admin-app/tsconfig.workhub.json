{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "react", "react-dom"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.workhub.tsbuildinfo"
  },
  "include": [
    "src/main-workhub.tsx",
    "src/WorkhubStandaloneApp.tsx",
    "src/pages/WorkHubPage.tsx",
    "src/pages/workhub/**/*.ts",
    "src/pages/workhub/**/*.tsx",
    "src/features/communication/**/*.ts",
    "src/features/communication/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/types/**/*.ts",
    "src/index.css",
    "src/App.css",
    "vite.config.ts"
  ],
  "exclude": [
    "src/components/reactvideoeditor/**",
    "src/components/toorgen/**",
    "src/reactvideoeditor/**",
    "src/pages/VideoEditorPage.tsx",
    "src/pages/VideoEditorV2Page.tsx",
    "src/pages/LabNewLayout/**",
    "src/pages/LabNewLayoutPage.tsx",
    "src/pages/LabPage.tsx",
    "src/pages/ToorGenPage/**",
    "src/pages/ToorGenExtendPage/**"
  ]
}
