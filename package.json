{
  "name": "quiz-engine",
  "version": "1.0.49",
  "description": "QYan - Real-time multiplayer quiz platform (Kahoot-inspired) PoC",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "inject-version": "node scripts/inject-version.js",
    "verify:game-modes": "node scripts/verify-game-mode-runtimes.js",
    "verify:question-types": "node scripts/verify-question-type-registries.js",
    "verify:question-architecture": "node scripts/verify-question-type-architecture.js",
    "verify:question-system": "npm run verify:question-types && npm run verify:question-architecture && npm run verify:game-modes"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^10.3.0",
    "iconv-lite": "^0.7.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.4",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "socket.io-client": "^4.8.3"
  }
}
